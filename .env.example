ROBINHOOD_EXPLORER_API_KEY=
# Token lane. On Robinhood Chain this is USDG, the chain's natively issued stablecoin.
# USDG uses 6 decimals, so a 5,000 USDG daily cap is 5000000000 base units.
USDG_ADDRESS=
USDG_TREASURY_ADDRESS=
USDG_DAILY_LIMIT_UNITS=
USDG_RECIPIENT=
OPERATOR_PRIVATE_KEY=
PORT=8787
API_KEY=replace_with_strong_random_api_key
