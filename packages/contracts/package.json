{
  "name": "@arb-guardian/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint \"contracts/**/*.sol\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "hardhat run scripts/verify.ts",
    "evidence": "hardhat run scripts/evidence-pack.ts",
    "example:operator": "hardhat run examples/operator-spend.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "seed:sepolia": "hardhat run scripts/seed.ts --network arbitrumSepolia",
    "enroll:safe:sepolia": "hardhat run scripts/enroll-safe.ts --network arbitrumSepolia",
    "deploy:sepolia:full": "hardhat run scripts/deploy.ts --network arbitrumSepolia && hardhat run scripts/seed.ts --network arbitrumSepolia && hardhat run scripts/enroll-safe.ts --network arbitrumSepolia",
    "deploy:robinhood": "hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "seed:robinhood": "hardhat run scripts/seed.ts --network robinhoodTestnet",
    "enroll:safe:robinhood": "hardhat run scripts/enroll-safe.ts --network robinhoodTestnet",
    "deploy:robinhood:full": "hardhat run scripts/deploy.ts --network robinhoodTestnet && hardhat run scripts/seed.ts --network robinhoodTestnet && hardhat run scripts/enroll-safe.ts --network robinhoodTestnet",
    "enroll:real-safe": "hardhat run scripts/enroll-real-safe.ts",
    "drill:incident": "hardhat run scripts/incident-drill.ts"
  },
  "dependencies": {
    "@arb-guardian/shared": "0.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@safe-global/safe-contracts": "^1.4.1",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.18",
    "solhint": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
